{
    "name": "silvershop-suite/related-products",
    "description": "Related, up-sell and cross-sell product relations for SilverShop: hand-curated links shown on the product page and in the cart.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "related-products", "upsell", "cross-sell", "merchandising"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Remy Vaartjes",
            "email": "remy@xd.nl",
            "role": "Lead developer"
        },
        {
            "name": "SilverShop-Suite Contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/cms": "^6.0",
        "silvershop/core": "^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/sqlite3": "^4"
    },
    "suggest": {
        "silvershop-suite/brands": "Adds the 'same brand' automatic related-products provider.",
        "silvershop-suite/analytics": "Adds the 'also viewed' automatic related-products provider."
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\RelatedProducts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\RelatedProducts\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
